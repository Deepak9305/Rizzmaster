{
  "redirects": [
    {
      "source": "/rizzline",
      "destination": "/rizzline-pickup-lines",
      "permanent": true
    },
    {
      "source": "/rizzline/",
      "destination": "/rizzline-pickup-lines",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rizzline-pickup-lines",
      "destination": "/rizzline-pickup-lines/index.html"
    },
    {
      "source": "/rizzline-pickup-lines/",
      "destination": "/rizzline-pickup-lines/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/landing",
      "destination": "/landing/index.html"
    },
    {
      "source": "/landing/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/blog/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/blog/logo.png",
      "destination": "/logo.png"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/billing/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/billing/logo.png",
      "destination": "/logo.png"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

